my $problems = FixMyStreet::DB->resultset('Problem');

# A home nao le o banco a cada visita: as ocorrencias recentes e os quatro
# numeros de "Catanduva em numeros" passam pelo Memcached.
#
# Sem esvaziar, a home continua mostrando o que havia antes - e, logo depois de
# uma limpeza, ela anuncia "Ainda nao ha ocorrencias registradas" com o banco
# cheio, ou os numeros antigos com o banco vazio. Foi exatamente o que aconteceu
# na primeira vez que este script apagou tudo, e leva um tempo ate desconfiar do
# cache em vez da pagina.
#
# `flush_all` porque as chaves carregam a data e o intervalo no nome: apagar
# uma a uma exigiria reproduzir aqui a regra de nomeacao de quem as escreve, o
# que fica errado no dia em que ela mudar. Num ambiente de teste, esvaziar tudo
# nao custa nada.
sub esvazia_cache {
    my $mc = Memcached::instance();
    return unless $mc && $mc->get_sock;
    $mc->flush_all;
    say 'cache da home esvaziado';
}

# ------------------------------------------------------------------- limpar
#
# Apaga TODAS as ocorrencias, e nao so as que este script criou.
#
# A versao anterior casava pelo titulo, o que servia para desfazer um povoamento
# e nao servia para o que este script passou a ser: a base de um ambiente em que
# se possa *verificar* a faixa do mapa. Uma ocorrencia de teste esquecida entra
# na contagem e na faixa como qualquer outra, e ai o numero que se foi conferir
# ja nao e o numero que o conjunto previa.
#
# Vai junto o que pende das ocorrencias: os comentarios, por chave estrangeira,
# e os alertas de acompanhamento, que guardam o id da ocorrencia em `parameter`
# sem chave nenhuma e por isso sobreviveriam apontando para o vazio.
#
# E vao as fotografias. Elas nao estao no banco: `PHOTO_STORAGE_BACKEND` e
# `FileSystem`, e os arquivos ficam em `UPLOAD_DIR` - fora do repositorio, o que
# e justamente por que o `upload/` da arvore aparece vazio e as miniaturas
# davam 404 (UI-010).
if ($opt{limpar}) {
    my $n = $problems->count;

    for my $p ($problems->all) {
        $p->comments->delete;
    }

    # Alertas cujo alvo e uma ocorrencia. Os de area (`local_problems` e afins)
    # nao apontam para nenhuma e continuam validos.
    my $alertas = FixMyStreet::DB->resultset('Alert')->search({
        alert_type => [ 'new_updates', 'questionnaire' ],
    });
    my $na = $alertas->count;
    $alertas->delete;

    $problems->delete;

    my $dir = FixMyStreet->config('PHOTO_STORAGE_OPTIONS')->{UPLOAD_DIR};
    my $nf = 0;
    if ($dir && -d $dir) {
        opendir(my $dh, $dir) or die "nao consegui abrir $dir: $!\n";
        for my $f (readdir $dh) {
            next unless $f =~ /\.(jpeg|jpg|png|gif|tiff)$/i;
            unlink File::Spec->catfile($dir, $f) and $nf++;
        }
        closedir $dh;
    }

    esvazia_cache();

    say "removidas: $n ocorrencias, $na alertas de acompanhamento, $nf fotografias";
    exit 0;
}

# -------------------------------------------------------------------- corpo
my $body = FixMyStreet::DB->resultset('Body')->find({ name => $BODY })
    or die "Orgao '$BODY' nao existe. Rode bin/catanduva/ambiente-local antes.\n";

my $user = FixMyStreet::DB->resultset('User')->find_or_create({
    email => 'exemplos@catanduva.local',
    email_verified => 1,
    name => 'Morador de Catanduva',
});

# --------------------------------------------------------------------- foto
# Uma imagem distinta por ocorrencia, para dar para diferenciar as miniaturas
# na listagem. Nao e foto de verdade - e um retangulo com o titulo escrito.
sub gera_foto {
    my ($texto, $cor) = @_;

    my $img = Image::Magick->new;
    $img->Set(size => '640x480');
    $img->ReadImage("canvas:$cor");
    $img->Annotate(
        text => $texto, gravity => 'Center', fill => 'white',
        pointsize => 28, font => 'DejaVu-Sans',
    );
    $img->Set(magick => 'JPEG', quality => 82);

    my @blobs = $img->ImageToBlob;
    return $blobs[0];
}

# ---------------------------------------------------------------- endereco
# O endereco do cartao sai de `problem.geocode`, e quem o preenche no fluxo real
# e o `report_new_munge_before_insert` do cobrand, com o mesmo geocodificador
# reverso que resolve o CEP. Aqui chamamos o mesmo metodo: a resposta gravada e
# a de verdade, para aquelas coordenadas, e nao um endereco escrito a mao.
#
# Nominatim pede cerca de uma consulta por segundo. Sao treze.
my $cobrand = FixMyStreet::Cobrand::Catanduva->new;

sub geocodifica {
    my ($lat, $lon) = @_;
    my $r = $cobrand->reverse_geocode_pin($lat, $lon);
    sleep 1;
    return $r;
}

# -------------------------------------------------------------------- criar
my $criadas = 0;
for my $e (@EXEMPLOS) {
    if ($problems->search({ title => $e->{titulo} })->count) {
        say "ja existe, pulando: $e->{titulo}";
        next;
    }

    # `cor` ausente significa, de proposito, ocorrencia sem fotografia: o cartao
    # tem de mostrar o espaco reservado, e isso tambem precisa ser visto.
    my $foto;
    if ($e->{cor}) {
        my $blob = gera_foto($e->{titulo}, $e->{cor});
        my $fileid = FixMyStreet::PhotoStorage->backend->store_photo($blob);
        $foto = "$fileid.jpeg";
    }

    my $geocode = geocodifica($e->{lat}, $e->{lon});
    my $cep = $geocode ? $cobrand->normalise_cep($geocode->{address}{postcode}) : '';

    my $quando = DateTime->now->subtract(days => $e->{dias});

    my $p = $problems->create({
        title      => $e->{titulo},
        detail     => $e->{detalhe},
        category   => $e->{categoria},
        latitude   => $e->{lat},
        longitude  => $e->{lon},
        postcode   => $cep,
        geocode    => $geocode,
        state      => $e->{estado},
        cobrand    => 'catanduva',
        bodies_str => $body->id,
        areas      => ',161,',
        user       => $user,
        name       => $user->name,
        anonymous  => 0,
        used_map   => 1,
        confirmed  => $quando,
        lastupdate => $quando,
        whensent   => $quando,
        photo      => $foto,
    });

    # Aprovadas de proposito: sem isto o MOD-002 as esconde, e o objetivo aqui
    # e justamente ver as fotografias no mapa e na listagem.
    if ($foto) {
        $p->set_extra_metadata(publish_photo => 1);
        $p->update;
    }

    my $rua = $geocode ? $cobrand->short_address($p) : '';
    say sprintf('criada #%-4d %-36s %-18s %-7s %s',
        $p->id, $e->{titulo}, $e->{estado},
        $e->{dentro} ? 'no quadro' : 'fora',
        $rua || '(sem endereco)');
    $criadas++;
}

if ($criadas) {
    my $dentro = grep { $_->{dentro} } @EXEMPLOS;
    say '';
    say sprintf('%d ocorrencias: %d dentro do enquadramento padrao, %d fora.',
        scalar(@EXEMPLOS), $dentro, scalar(@EXEMPLOS) - $dentro);
    say "A faixa do mapa deve anunciar \"Ocorrencias proximas ($dentro)\" em";
    say 'qualquer uma das tres larguras, e as demais vem depois do divisor.';
}

# Regenera o resumo que a pagina "Todas as ocorrencias" le. Sem isto ela
# responde com erro, e o menu parece quebrado logo depois de povoar o banco -
# que foi exatamente como este defeito apareceu.
#
# Sao TRES arquivos, e a pagina precisa dos tres:
#
#   --table        all-reports.json                 lista de orgaos
#   (sem flag)     all-reports-dashboard.json       estatisticas gerais
#   --all-bodies   all-reports-dashboard-<id>.json  estatisticas por orgao
#
# Gerar so o primeiro deixa a pagina respondendo 200 com tudo zerado: o
# load_dashboard_data engole a falta num eval e segue sem os dados, entao nada
# denuncia o que falta. Foi assim que este defeito sobreviveu a uma primeira
# correcao - a mensagem de erro so citava o primeiro arquivo.
if ($criadas) {
    my $script = FixMyStreet->path_to('bin/update-all-reports')->stringify;
    for my $args ( ['--table'], [], ['--all-bodies'] ) {
        system($script, @$args) == 0
            or warn "aviso: falhou update-all-reports @$args\n";
    }
    say 'resumos de /reports regenerados';
    esvazia_cache();
}

say '';
say "criadas: $criadas";
say 'Mapa:      http://127.0.0.1.nip.io:3000/around?lat=-21.1383;lon=-48.9736;zoom=14';
say 'Listagem:  http://127.0.0.1.nip.io:3000/reports';
say '';
say 'As fotografias ja entram aprovadas. Para ver o portao do MOD-002 agindo,';
say 'limpe o publish_photo de uma delas pelo /admin e recarregue a pagina.';
